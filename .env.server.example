# ============================================================
# Agent 消息总线 — 服务端环境变量模板
# ============================================================
# 使用方法：
#   1. 复制此文件为 .env.server
#   2. 修改以下密钥值
#   3. 运行: docker compose -f compose.server.yaml up -d
# ============================================================

# 🔴 重要：请修改为强密码
# 管理面板和管理 API 的访问密钥
# 默认值为 'admin'，生产环境务必修改！
ADMIN_TOKEN=your_strong_admin_token_here

# 🔴 重要：请修改为强密钥
# 用于生成 Agent 的 HMAC-SHA256 认证 Token
# 所有 Agent 注册时使用此密钥计算 Token
AGENT_TOKEN_SECRET=your_strong_agent_secret_here

# 中继层认证 Token（仅启用 relay-server 时需要）
# 中继层与总线之间的通信凭证
RELAY_TOKEN=your_relay_token_here
