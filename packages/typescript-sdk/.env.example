# 环境变量配置参考

# 以下配置项均可通过 openclaw.json 的 channels.claw-bus 设置

# Agent Bus HTTP API 地址
# CHANNEL_CLAWBUS_BUS_URL=http://localhost:4322

# Agent Bus WebSocket 地址
# CHANNEL_CLAWBUS_BUS_WS_URL=ws://localhost:4322/ws

# 认证 Token（部署时必填）
# CHANNEL_CLAWBUS_BUS_TOKEN=your-token-here

# Agent 身份标识
# CHANNEL_CLAWBUS_AGENT_ID=my-agent

# 连接模式：websocket 或 poll
# CHANNEL_CLAWBUS_MODE=websocket
